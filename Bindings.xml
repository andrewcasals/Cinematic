<Bindings>
	<Binding name="CINEMATIC_TOGGLE" header="CINEMATIC" category="ADDONS">
		Cinematic_Toggle()
	</Binding>
	<Binding name="CINEMATIC_HIDEUI" category="ADDONS">
		Cinematic_ToggleUI()
	</Binding>
	<Binding name="CINEMATIC_TOGGLEEFFECTS" category="ADDONS">
		Cinematic_ToggleVisualEffects()
	</Binding>
	<Binding name="CLICK CinematicMasterWheelButton:LeftButton" category="ADDONS">
	</Binding>
	<Binding name="CINEMATIC_CAMWHEEL" category="ADDONS" runOnUp="true">
		Cinematic_CameraWheel(keystate)
	</Binding>
	<Binding name="CLICK CinematicMenuWheelButton:LeftButton" category="ADDONS">
	</Binding>
	<Binding name="CLICK CinematicMarkerWheelButton:LeftButton" category="ADDONS">
	</Binding>
	<Binding name="CLICK CinematicWorldMarkerWheelButton:LeftButton" category="ADDONS">
	</Binding>
	<Binding name="CLICK CinematicVisionWheelButton:LeftButton" category="ADDONS">
	</Binding>
	<Binding name="CINEMATIC_VISION_HEAL" category="ADDONS">
		Cinematic_ToggleVision("heal")
	</Binding>
	<Binding name="CINEMATIC_VISION_QUEST" category="ADDONS">
		Cinematic_ToggleVision("quest")
	</Binding>
	<Binding name="CINEMATIC_VISION_DUEL" category="ADDONS">
		Cinematic_ToggleVision("duel")
	</Binding>
	<Binding name="CINEMATIC_VISION_ROLL" category="ADDONS">
		Cinematic_ToggleVision("roll")
	</Binding>
	<Binding name="CINEMATIC_CAM_IDLE" category="ADDONS">
		Cinematic_StartCam("idle")
	</Binding>
	<Binding name="CINEMATIC_CAM_COZY" category="ADDONS">
		Cinematic_StartCam("cozy")
	</Binding>
	<Binding name="CINEMATIC_CAM_VISTA" category="ADDONS">
		Cinematic_StartCam("vista")
	</Binding>
	<Binding name="CINEMATIC_CAM_FISH" category="ADDONS">
		Cinematic_StartCam("fish")
	</Binding>
	<Binding name="CINEMATIC_CAM_TELE" category="ADDONS">
		Cinematic_StartCam("tele")
	</Binding>
	<Binding name="CINEMATIC_CAM_DEATH" category="ADDONS">
		Cinematic_StartCam("death")
	</Binding>
	<Binding name="CINEMATIC_SHOWTOOLTIPS" category="ADDONS" runOnUp="true">
		Cinematic_ShowTooltips(keystate)
	</Binding>
	<Binding name="CINEMATIC_TOGGLETOOLTIPS" category="ADDONS">
		Cinematic_ToggleTooltips()
	</Binding>
</Bindings>
